# Site
NEXT_PUBLIC_SITE_URL=https://blog.example.com

# Admin (single user)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-random-string
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Optional: path to ffmpeg for video re-encode (metadata strip). Defaults to `ffmpeg` on PATH.
# FFMPEG_PATH=/usr/bin/ffmpeg

# Supabase
# Replace with real values from Supabase → Project Settings → API
# (placeholder URLs cause 7s timeouts and empty blog data)
NEXT_PUBLIC_SUPABASE_URL=https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

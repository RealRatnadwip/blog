# Admin (single user)
ADMIN_USERNAME=
ADMIN_PASSWORD=
AUTH_SECRET=

# Optional: path to ffmpeg for video re-encode (metadata strip). Defaults to `ffmpeg` on PATH.
# FFMPEG_PATH=/usr/bin/ffmpeg

# Supabase
